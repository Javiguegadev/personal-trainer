{
  "name": "@pt/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start",
    "android": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start --android",
    "ios": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start --ios",
    "web": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start --web",
    "dev:mock": "node --env-file-if-exists=../../.env scripts/start-mock.mjs",
    "web:mock": "node --env-file-if-exists=../../.env scripts/start-mock.mjs --web",
    "build": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "doctor": "npx --yes expo-doctor"
  },
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@pt/api-client": "workspace:*",
    "@pt/contracts": "workspace:*",
    "@pt/core": "workspace:*",
