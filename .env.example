# Copy to .env (never commit .env). Values for the DEV environment only.
# EXPO_PUBLIC_* values are inlined into the app bundle: they are PUBLIC. Never put secrets there.

# --- API (apps/api) ---
API_PORT=8787
# Comma-separated browser origins allowed by CORS (Expo web dev server, landing)
WEB_ORIGINS=http://localhost:8081

# --- App (apps/app) ---
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Anthropic (server-side only) ---
ANTHROPIC_API_KEY=

# --- Payments: RevenueCat (in-app + web entitlements) + Paddle (web checkout, merchant of record) ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
REVENUECAT_WEBHOOK_AUTH=

# --- Observability (before launch) ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
